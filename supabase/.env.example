# Copy file này thành .env (cùng thư mục) và điền giá trị thật.
# .env đã nằm trong .gitignore — không commit lên git.

# Từ Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Từ Supabase Dashboard > Account > Access Tokens (dùng cho `supabase login` không cần trình duyệt)
SUPABASE_ACCESS_TOKEN=
